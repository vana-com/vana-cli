# Same private key as the CLI's selected VANA_APP_KEY, never an owner key.
VANA_PRIVATE_KEY=0x...
# The address printed by `vana app whoami --network moksha --json`.
# Startup refuses a key/address mismatch. Never use NEXT_PUBLIC_ for a key.
VANA_APP_ADDRESS=0x...
APP_URL=http://localhost:3090
# Production Vana hosts with an explicitly fixed Moksha network.
# dev selects app-dev.vana.org; it still uses Moksha.
VANA_ENV=prod

# Explicit opt-in and both caps are required; unset means no payment.
VANA_ALLOW_MOKSHA_PAYMENT=false
VANA_MAX_FEE=0.02
VANA_MAX_TOTAL=0.04
# Optional private local persistence directory, never public/static storage.
# VANA_SHELF_DIRECTORY=/private/path/research-shelf
# Existing local dev Web approval only, not a new consent or source login.
# VANA_APPROVAL_URL=http://localhost:3083
# VANA_RESUME_REQUEST_ID=dcr_...
