# Server-only app key. Register the app identity on the selected network.
VANA_PRIVATE_KEY=0x...
# VANA_APP_PRIVATE_KEY is also accepted when VANA_PRIVATE_KEY is unset.
APP_URL=http://localhost:3001
# dev uses Moksha and app-dev.vana.org. prod uses mainnet and app.vana.org.
VANA_ENV=dev
# Source and scopes are configured in src/config.ts.
