# Same private key as the CLI's selected VANA_APP_KEY, never an owner key.
VANA_PRIVATE_KEY=0x...
# The address printed by `vana app whoami --network moksha --json`.
# Startup refuses a key/address mismatch. Never use NEXT_PUBLIC_ for a key.
VANA_APP_ADDRESS=0x...
APP_URL=http://localhost:3090
# Production Vana hosts with an explicitly fixed Moksha network.
# dev selects app-dev.vana.org; it still uses Moksha.
VANA_ENV=prod
